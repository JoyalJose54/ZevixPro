<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/black"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/btn_back"
            android:fontFamily="sans-serif-medium"
            android:text="Set App Lock"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Lock Method Segmented Buttons (PIN / Pattern) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_common_btn_light"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_pin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_promoter_active"
            android:gravity="center"
            android:text="4-Digit PIN"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_pattern"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="Pattern"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Biometric Switch Option Row -->
    <RelativeLayout
        android:id="@+id/row_biometric"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Enable Biometrics (Fingerprint / Face)"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_biometric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:checked="true"
            app:thumbTint="@color/accent_color" />
    </RelativeLayout>

    <!-- Status & Prompt Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tv_setup_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Set a 4-digit PIN"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_setup_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter 4 numbers for your lock code"
            android:textColor="#9e9e9e"
            android:textSize="13sp" />

        <!-- 4 PIN Dots -->
        <LinearLayout
            android:id="@+id/layout_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:id="@+id/dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/bg_pin_dot_empty" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pattern View Container -->
    <LinearLayout
        android:id="@+id/layout_pattern_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.app.zevix.widget.PatternLockView
            android:id="@+id/pattern_lock_view"
            android:layout_width="300dp"
            android:layout_height="300dp" />
    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/layout_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:columnCount="3"
        android:paddingHorizontal="24dp"
        android:rowCount="4">

        <TextView
            android:id="@+id/key_1"
            style="@style/PinKeypadButton"
            android:text="1" />

        <TextView
            android:id="@+id/key_2"
            style="@style/PinKeypadButton"
            android:text="2" />

        <TextView
            android:id="@+id/key_3"
            style="@style/PinKeypadButton"
            android:text="3" />

        <TextView
            android:id="@+id/key_4"
            style="@style/PinKeypadButton"
            android:text="4" />

        <TextView
            android:id="@+id/key_5"
            style="@style/PinKeypadButton"
            android:text="5" />

        <TextView
            android:id="@+id/key_6"
            style="@style/PinKeypadButton"
            android:text="6" />

        <TextView
            android:id="@+id/key_7"
            style="@style/PinKeypadButton"
            android:text="7" />

        <TextView
            android:id="@+id/key_8"
            style="@style/PinKeypadButton"
            android:text="8" />

        <TextView
            android:id="@+id/key_9"
            style="@style/PinKeypadButton"
            android:text="9" />

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:layout_gravity="center"
            android:layout_columnWeight="1" />

        <TextView
            android:id="@+id/key_0"
            style="@style/PinKeypadButton"
            android:text="0" />

        <FrameLayout
            android:id="@+id/key_backspace"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:layout_gravity="center"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pin_key_compact"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_backspace"
                app:tint="@color/white" />
        </FrameLayout>
    </GridLayout>

    <!-- Cancel button matching photo -->
    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="28dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="Cancel"
        android:textColor="#88ffffff"
        android:textSize="16sp" />

</LinearLayout>

