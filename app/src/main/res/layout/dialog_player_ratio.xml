<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_top_radius"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:background="@drawable/bg_common_btn_light"
            android:padding="16dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:srcCompat="@drawable/ic_back"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ratio"
            android:layout_marginStart="-8dp"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ratio_section_screen"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_ratio_fit"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_ratio_fit"
                        android:background="@drawable/bg_oval_802a"
                        android:padding="10dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:srcCompat="@drawable/ic_ratio_fit"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_fit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ratio_fit"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_ratio_fill"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_ratio_fill"
                        android:background="@drawable/bg_oval_802a"
                        android:padding="10dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:srcCompat="@drawable/ic_ratio_fill"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_fill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ratio_fill"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_ratio_original"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_ratio_original"
                        android:background="@drawable/bg_oval_802a"
                        android:padding="10dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:srcCompat="@drawable/ic_ratio_original"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_original"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ratio_original"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_ratio_stretch"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_ratio_stretch"
                        android:background="@drawable/bg_oval_802a"
                        android:padding="10dp"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:srcCompat="@drawable/ic_ratio_stretch"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_stretch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ratio_stretch"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ratio_section_standard"
                android:layout_marginStart="16dp"/>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_16_9"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="16:9"
                        android:layout_marginEnd="24dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_4_3"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="4:3"
                        android:layout_marginEnd="24dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_18_9"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="18:9"
                        android:layout_marginEnd="24dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_195_9"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="19.5:9"
                        android:layout_marginEnd="24dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_20_9"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="20:9"
                        android:layout_marginEnd="24dp"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="#ccffffff"
                        android:gravity="center"
                        android:id="@+id/tv_ratio_21_9"
                        android:background="@drawable/bg_oval_802a"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="21:9"/>
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ratio_section_cinema"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ccffffff"
                    android:gravity="center"
                    android:id="@+id/tv_ratio_185"
                    android:background="@drawable/bg_oval_802a"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="1.85:1"
                    android:layout_marginEnd="24dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ccffffff"
                    android:gravity="center"
                    android:id="@+id/tv_ratio_221"
                    android:background="@drawable/bg_oval_802a"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="2.21:1"
                    android:layout_marginEnd="24dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ccffffff"
                    android:gravity="center"
                    android:id="@+id/tv_ratio_235"
                    android:background="@drawable/bg_oval_802a"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="2.35:1"
                    android:layout_marginEnd="24dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="12sp"
                    android:textColor="#ccffffff"
                    android:gravity="center"
                    android:id="@+id/tv_ratio_239"
                    android:background="@drawable/bg_oval_802a"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="2.39:1"/>
            </LinearLayout>
            <View
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/playerDialogDivider"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ratio_remember_ratio"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ratio_remember_ratio_desc"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_remember_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ratio_switch_on_tap"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ratio_switch_on_tap_desc"/>
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ratio_on_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
